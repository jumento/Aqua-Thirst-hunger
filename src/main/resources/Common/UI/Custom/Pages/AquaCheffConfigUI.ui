          LayoutMode: Top;
          Anchor: (Height: 15);
        }
        $C.@TextButton #BtnHard {
          @Anchor = Anchor(Width: 200, Height: 40);
          @Text = "HARD MODE";
          Padding: (Top: 10, Bottom: 10);
        }
        Group #Spacer3 {
          LayoutMode: Top;
          Anchor: (Height: 15);
        }
        $C.@SmallSecondaryTextButton #BtnCustom {
          @Anchor = Anchor(Width: 200, Height: 40);
          @Text = "CUSTOM SETTINGS";
