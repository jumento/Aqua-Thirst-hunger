        $C.@TextButton #BtnEasy {
          @Anchor = Anchor(Width: 200, Height: 40);
          @Text = "EASY MODE";
          Padding: (Top: 10, Bottom: 10);
        }
        Group #Spacer1 {
          LayoutMode: Top;
          Anchor: (Height: 15);
        }
        $C.@TextButton #BtnNormal {
          @Anchor = Anchor(Width: 200, Height: 40);
          @Text = "NORMAL MODE";
          Padding: (Top: 10, Bottom: 10);
        }
